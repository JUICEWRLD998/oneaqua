{
  "name": "firstline",
  "version": "0.1.0",
  "private": true,
  "description": "Firstline: a hierarchy-gated restoration prescription with a BACI outcome verdict, built on OneAquaHealth D2.4.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "verify:cites": "node scripts/verify-d24-cites.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify:data && npm run build",
    "verify:data": "node scripts/verify-data.mjs",
    "fixture": "tsx scripts/export-fixture.ts",
    "scenario": "node scripts/gen-scenario.mjs",
    "validate:fhir": "tsx scripts/validate-fhir.ts"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "framer-motion": "^12.0.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
